<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
              http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="investment_summary"
              pageWidth="595" pageHeight="842" columnWidth="535"
              leftMargin="30" rightMargin="30" topMargin="20" bottomMargin="20"
              uuid="a7b9d7e2-f2e3-4c3c-b24c-11c1c0eae117">

    <parameter name="createdBy" class="java.lang.String"/>

    <field name="ref" class="java.lang.String"/>
    <field name="investorName" class="java.lang.String"/>
    <field name="email" class="java.lang.String"/>
    <field name="amount" class="java.lang.Double"/>
    <field name="description" class="java.lang.String"/>
    <field name="date" class="java.time.LocalDateTime"/>
    <field name="typeId" class="java.lang.String"/>
    <variable name="GroupAmountSum" class="java.lang.Double" calculation="Sum" resetType="Group" resetGroup="TypeGroup">
        <variableExpression><![CDATA[$F{amount}]]></variableExpression>
    </variable>
    <variable name="TotalAmount" class="java.lang.Double" calculation="Sum">
        <variableExpression><![CDATA[$F{amount}]]></variableExpression>
    </variable>
    <group name="TypeGroup">
        <groupExpression><![CDATA[$F{typeId}]]></groupExpression>
    </group>





    <title>
        <band height="80">
            <image>
                <reportElement x="0" y="0" width="50" height="50"/>
                <imageExpression><![CDATA[getClass().getResourceAsStream("/jasper/logo.png")]]></imageExpression>
            </image>
            <textField>
                <reportElement x="60" y="5" width="475" height="30"/>
                <textElement textAlignment="Center">
                    <font size="18" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["Investment Summary Report"]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="60" y="40" width="475" height="20"/>
                <textElement textAlignment="Center">
                    <font size="10" isItalic="true"/>
                </textElement>
                <textFieldExpression><![CDATA["Generated by: " + $P{createdBy}]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <columnHeader>
        <band height="25">
            <staticText><reportElement x="0" y="0" width="60" height="20"/><text><![CDATA[Ref]]></text></staticText>
            <staticText><reportElement x="60" y="0" width="90" height="20"/><text><![CDATA[Investor]]></text></staticText>
            <staticText><reportElement x="150" y="0" width="110" height="20"/><text><![CDATA[Email]]></text></staticText>
            <staticText><reportElement x="260" y="0" width="60" height="20"/><text><![CDATA[Amount]]></text></staticText>
            <staticText><reportElement x="320" y="0" width="135" height="20"/><text><![CDATA[Description]]></text></staticText>
            <staticText><reportElement x="455" y="0" width="80" height="20"/><text><![CDATA[Date]]></text></staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="20">
            <textField><reportElement x="0" y="0" width="60" height="20"/><textFieldExpression><![CDATA[$F{ref}]]></textFieldExpression></textField>
            <textField><reportElement x="60" y="0" width="90" height="20"/><textFieldExpression><![CDATA[$F{investorName}]]></textFieldExpression></textField>
            <textField><reportElement x="150" y="0" width="110" height="20"/><textFieldExpression><![CDATA[$F{email}]]></textFieldExpression></textField>
            <textField><reportElement x="260" y="0" width="60" height="20"/><textFieldExpression><![CDATA[$F{amount}]]></textFieldExpression></textField>
            <textField><reportElement x="320" y="0" width="135" height="20"/><textFieldExpression><![CDATA[$F{description}]]></textFieldExpression></textField>
            <textField><reportElement x="455" y="0" width="80" height="20"/><textFieldExpression><![CDATA[$F{date}.toLocalDate().toString()]]></textFieldExpression></textField>
        </band>
    </detail>

    <pageFooter>
        <band height="20">
            <textField>
                <reportElement x="0" y="0" width="535" height="15"/>
                <textElement textAlignment="Right">
                    <font size="8" isItalic="true"/>
                </textElement>
                <textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

    <summary>
        <band height="480">
            <staticText>
                <reportElement x="260" y="5" width="140" height="20"/>
                <textElement textAlignment="Right"><font isBold="true"/></textElement>
                <text><![CDATA[Total Investment:]]></text>
            </staticText>
            <textField pattern="#0.00">
                <reportElement x="400" y="5" width="100" height="20"/>
                <textElement><font isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$V{TotalAmount}]]></textFieldExpression>
            </textField>

            <!-- Bar Chart -->
            <staticText>
                <reportElement x="0" y="30" width="535" height="20"/>
                <textElement textAlignment="Center"><font size="14" isBold="true"/></textElement>
                <text><![CDATA[Total Investment by Type]]></text>
            </staticText>
            <barChart>
                <chart>
                    <reportElement x="0" y="60" width="535" height="130"/>
                    <chartTitle/><chartLegend position="Bottom"/>
                </chart>
                <categoryDataset>
                    <categorySeries>
                        <seriesExpression><![CDATA["Investment"]]></seriesExpression>
                        <categoryExpression><![CDATA[$F{typeId}]]></categoryExpression>
                        <valueExpression><![CDATA[$F{amount}]]></valueExpression>
                    </categorySeries>
                </categoryDataset>
                <barPlot isShowLabels="true"><plot/><itemLabel/></barPlot>
            </barChart>

            <!-- Line Chart -->
            <staticText>
                <reportElement x="0" y="200" width="535" height="20"/>
                <textElement textAlignment="Center"><font size="14" isBold="true"/></textElement>
                <text><![CDATA[Investment Trends]]></text>
            </staticText>
            <lineChart>
                <chart>
                    <reportElement x="0" y="230" width="535" height="200"/>
                </chart>
                <categoryDataset>
                    <categorySeries>
                        <seriesExpression><![CDATA["Amount"]]></seriesExpression>
                        <categoryExpression><![CDATA[$F{date}.toLocalDate().toString()]]></categoryExpression>
                        <valueExpression><![CDATA[$F{amount}]]></valueExpression>
                    </categorySeries>
                </categoryDataset>
                <linePlot><plot/></linePlot>
            </lineChart>
        </band>
    </summary>

    <noData>
        <band height="30">
            <staticText>
                <reportElement x="0" y="5" width="535" height="20"/>
                <textElement textAlignment="Center">
                    <font size="12" isBold="true" isItalic="true"/>
                </textElement>
                <text><![CDATA[No investment data available.]]></text>
            </staticText>
        </band>
    </noData>

</jasperReport>
